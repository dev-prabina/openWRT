#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PROG=/usr/libexec/prime_loadbalance_daemon

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/ucode "$PROG"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/bin/ucode "$PROG" run-once
    ip rule del pref 1000 2>/dev/null || true
    ip rule del pref 2000 2>/dev/null || true
    ip rule del pref 500 2>/dev/null || true
    ip rule del pref 501 2>/dev/null || true
    ip route flush table 100 2>/dev/null || true
    ip route flush table 200 2>/dev/null || true
    nft delete table inet prime_loadbalance 2>/dev/null || true
}

reload_service() {
    stop
    start
}
